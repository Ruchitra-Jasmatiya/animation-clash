{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://massup-backend.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://massup-backend.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://massup-backend.onrender.com/static/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://massup-backend.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://massup-backend.onrender.com/media/:path*"
    }
  ]
}