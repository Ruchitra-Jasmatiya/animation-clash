{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://massup-backend.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://massup-backend.onrender.com/media/:path*" },
    { "source": "/admin", "destination": "https://massup-backend.onrender.com/admin/" },
    { "source": "/admin/:path*", "destination": "https://massup-backend.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://massup-backend.onrender.com/static/:path*" },
    { "source": "/((?!api/|media/|admin|static/|images/|videos/|assets/|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(images|videos|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
