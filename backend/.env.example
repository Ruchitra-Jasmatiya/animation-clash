SECRET_KEY=put-a-long-random-string-here
DEBUG=False
DATABASE_URL=postgres://...            # recommended in production (sqlite is used if empty)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=choose-a-strong-password
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-site.vercel.app

# Email (needed so customers receive their login OTP). Gmail example: use an "App password".
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-letter-app-password
DEFAULT_FROM_EMAIL=MASSUP <youraddress@gmail.com>

# E-mail on Render free plan (SMTP is blocked there): use Brevo's HTTPS API instead
BREVO_API_KEY=
BREVO_SENDER=MASSUP <your-verified-sender@gmail.com>

# Permanent storage for pictures/videos uploaded in admin (free account at cloudinary.com):
# Dashboard -> API Keys -> copy "API environment variable" -> paste as CLOUDINARY_URL
CLOUDINARY_URL=
